# Ví dụ các biến môi trường để tham khảo khi triển khai.
# Chương trình KHÔNG tự tải tệp .env. Cần thiết lập biến môi trường trước khi chạy.
# Chương trình mặc định chỉ mở trên máy đang chạy.
HOST=127.0.0.1
PORT=3000

# Chỉ khai báo mã khi thật sự cần điều khiển từ mạng ngoài.
# RPC_TOKEN=thay-bang-ma-dai-du-ngau-nhien

# Để trống để tự bấm kết nối trong giao diện.
TIKTOK_USER=

# Bật nếu muốn thử giao diện mà không cần nạp mô hình âm thanh.
# DISABLE_TTS=1
